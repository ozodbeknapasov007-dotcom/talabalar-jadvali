# Netlify'da (Site configuration → Environment variables) o'rnatiladi.
# Lokal ishga tushirishda .env.local fayliga yozing.

# Portalga kirish (login sahifasi). Ikkalasi bo'lmasa hech kim kira olmaydi.
# PORTAL_SESSION_SECRET — ixtiyoriy; bo'lmasa login+paroldan hosil qilinadi (parol almashsa hamma qayta kiradi)
PORTAL_LOGIN=
PORTAL_PASSWORD=
# PORTAL_SESSION_SECRET=

# Supabase Realtime Ma'lumotlar Bazasi (Barcha jonli talabalar ma'lumotlari uchun)
NEXT_PUBLIC_SUPABASE_URL=https://ebzzfbifmorqqtdfvenz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (kunlik hisobotlar, bot tugmalari va ma'lumotnomani botga yuborish)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Botdan foydalana oladigan boshqa xodimlar (vergul bilan); bot faqat ularga va TELEGRAM_CHAT_ID ga javob beradi
# TELEGRAM_ALLOWED_IDS=
# TELEGRAM_WEBHOOK_SECRET=   (ixtiyoriy — bo'sh bo'lsa tokendan hosil qilinadi)

# GitHub tokeni: remote_changes.json navbatiga yozish va students.json ni o'qish uchun
# (repo "contents: read & write" huquqi yetarli). HECH QACHON kodga yozmang.
GITHUB_TOKEN=

# AI hujjat tahlili (/api/ai-analyze): Python xizmati ishlamaganda (Netlify) va yangi
# talaba rasmlari uchun. OpenRouter kaliti — HECH QACHON kodga yozmang.
OPENROUTER_API_KEY=

# Ixtiyoriy — standart qiymatlar:
# GITHUB_OWNER=ozodbeknapasov007-dotcom
# GITHUB_REPO=talabalar-jadvali
# GITHUB_BRANCH=main

# Ma'lumot manbai: "local" — kompyuterdagi Python xizmati (localhost:8080) va
# ota papkadagi students.json; "github" — GitHub navbati (Netlify'da standart).
# SYNC_MODE=local
# LOCAL_API=http://localhost:8080

# Web Jurnal integratsiyasi (yangi talaba qo'shilganda avtomatik sync)
WEB_JURNAL_SYNC_URL=https://webjurnal.vercel.app/api/students/sync
WEB_JURNAL_API_KEY=

# Eski sayt manzili (guruh PDF jurnallari hozircha o'sha yerdan ochiladi)
# NEXT_PUBLIC_LEGACY_URL=https://talabalar-ro-yhati.vercel.app
