# Vercel'da (Settings → Environment Variables) o'rnatiladi.
# Lokal ishga tushirishda .env.local fayliga yozing.

# GitHub tokeni: remote_changes.json navbatiga yozish va students.json ni o'qish uchun
# (repo "contents: read & write" huquqi yetarli). HECH QACHON kodga yozmang.
GITHUB_TOKEN=

# Ixtiyoriy — standart qiymatlar:
# GITHUB_OWNER=OzodbekNapasov
# GITHUB_REPO=Talabalar-ro-yhati
# GITHUB_BRANCH=main

# Ma'lumot manbai: "local" — kompyuterdagi Python xizmati (localhost:8080) va
# ota papkadagi students.json; "github" — GitHub navbati (Vercel'da standart).
# SYNC_MODE=local
# LOCAL_API=http://localhost:8080

# Eski sayt manzili (guruh PDF jurnallari hozircha o'sha yerdan ochiladi)
# NEXT_PUBLIC_LEGACY_URL=https://talabalar-ro-yhati.vercel.app
