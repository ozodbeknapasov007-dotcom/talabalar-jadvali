{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/doc-preview",
      "destination": "/api/doc_preview"
    },
    {
      "source": "/api/view_group_pdf",
      "has": [
        {
          "type": "query",
          "key": "group",
          "value": "(?<group>.*)"
        }
      ],
      "destination": "/pdf_jurnallar/Guruh_:group.pdf"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/_next/(.*)",
      "destination": "/_next/$1"
    },
    {
      "source": "/logo.svg",
      "destination": "/logo.svg"
    },
    {
      "source": "/web",
      "destination": "/portal.html"
    },
    {
      "source": "/web/(.*)",
      "destination": "/portal.html"
    },
    {
      "source": "/((?!api/|pdf_jurnallar/|_next/|logo\\.svg|web|portal).*)",
      "destination": "/index.html"
    }
  ]
}
