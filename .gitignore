scratch/
arxiv/scratch/
arxiv/
backup/
files/extracted/
hujjatlar/shartnomalar/extracted/

# Juda katta HTML fayllar (har safar qayta generatsiya qilinadi)
eski_portal/hisobot.html
qayta_tekshiruv/hisobot.html
eski_portal/natijalar_hisoboti.html
messages.html

# .claude papkasi
.claude/

# IDE fayllar
.vscode/
.idea/

# Windows
Thumbs.db
Desktop.ini

# Log fayllar
*.log

# Zahira sozlamalari (bot tokeni — GitHub'ga tushmasin)
scripts/backup_config.json
scripts/backup_state.json
